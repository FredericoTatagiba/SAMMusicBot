# ===== Discord =====
# Token do bot (https://discord.com/developers/applications -> Bot -> Reset Token)
DISCORD_TOKEN=

# Prefixo dos comandos (música e rádio usam o MESMO). Ex.: #play, #radio Brasil
COMMAND_PREFIX='#'

# ===== Rádio =====
# A rádio usa o mesmo prefixo acima (ex.: #radio Brasil | #radio buscar jazz).
# Base da API do Radio Garden (o padrão já funciona; troque só se usar proxy).
RADIO_API_BASE_URL=https://radio.garden/api

# ===== Spotify =====
# Não precisa configurar nada: links do Spotify (faixa, álbum e playlist) são
# resolvidos sem credenciais (via página de embed pública). As variáveis abaixo
# são opcionais e atualmente ignoradas.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ===== Comportamento =====
# Tamanho máximo da fila por servidor
MAX_QUEUE_SIZE=200
# Tempo (ms) sem músicas na fila antes de sair do canal de voz (10000 = 10 s)
IDLE_DISCONNECT_MS=10000
# Tempo (ms) sozinho no canal (só o bot) antes de parar a reprodução (20000 = 20s)
EMPTY_CHANNEL_TIMEOUT_MS=20000
# Nível de log: debug | info | warn | error
LOG_LEVEL=info

# ===== Segurança =====
# IDs dos servidores (guilds) autorizados a usar o bot, separados por vírgula.
# Vazio = sem restrição (qualquer servidor). Com IDs, o bot SÓ responde nesses
# servidores e SAI automaticamente de qualquer outro em que for adicionado.
# Como obter o ID: ative o Modo Desenvolvedor no Discord
# (Configurações > Avançado), clique com o botão direito no servidor > Copiar ID.
ALLOWED_GUILD_IDS=

# ===== yt-dlp (contorno do bloqueio anti-bot do YouTube) =====
# O YouTube passou a exigir "Sign in to confirm you're not a bot" e responder
# HTTP 403 para clientes não autenticados. Trocar o player_client contorna isso
# sem credenciais. O padrão (tv,web_safari) já funciona na maioria dos casos;
# só mexa aqui se o YouTube mudar novamente. Ordem = prioridade de tentativa.
YTDLP_PLAYER_CLIENT=tv,web_safari
# Opcional: cookies de um navegador (ex.: firefox, chrome) para conteúdo
# restrito por idade/membros. Use uma conta descartável, NUNCA a principal.
# Deixe vazio para não enviar cookies (recomendado com player_client=tv).
YTDLP_COOKIES_FROM_BROWSER=
# Opcional: caminho para um arquivo cookies.txt (alternativa ao de cima).
YTDLP_COOKIES_FILE=
